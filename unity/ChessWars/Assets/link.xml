<!-- Keeps code that is only reached at run time from being stripped out of Android (IL2CPP) builds:
     engine types created by GameObject.CreatePrimitive, and the networking online play uses (Online/SocketIo.cs). -->
<linker>
  <assembly fullname="UnityEngine.PhysicsModule">
    <type fullname="UnityEngine.MeshCollider" preserve="all" />
    <type fullname="UnityEngine.BoxCollider" preserve="all" />
    <type fullname="UnityEngine.SphereCollider" preserve="all" />
    <type fullname="UnityEngine.CapsuleCollider" preserve="all" />
  </assembly>
  <assembly fullname="System">
    <namespace fullname="System.Net.WebSockets" preserve="all" />
  </assembly>
  <assembly fullname="System.Net.WebSockets" preserve="all" ignoreIfMissing="1" />
  <assembly fullname="System.Net.WebSockets.Client" preserve="all" ignoreIfMissing="1" />
  <!-- Google Mobile Ads (Game/Ads.cs): its platform clients are found by reflection and its Java callbacks
       arrive through AndroidJavaProxy, so keep the plugin whole (its own link.xml sits in a package). -->
  <assembly fullname="GoogleMobileAds" preserve="all" ignoreIfMissing="1" />
  <assembly fullname="GoogleMobileAds.Core" preserve="all" ignoreIfMissing="1" />
  <assembly fullname="GoogleMobileAds.Common" preserve="all" ignoreIfMissing="1" />
  <assembly fullname="GoogleMobileAds.Android" preserve="all" ignoreIfMissing="1" />
  <assembly fullname="GoogleMobileAds.Ump" preserve="all" ignoreIfMissing="1" />
  <assembly fullname="GoogleMobileAds.Ump.Android" preserve="all" ignoreIfMissing="1" />
</linker>
