# Copy to server/.env for local development, or set these as environment variables on the host.

NODE_ENV=production
PORT=8080

# MySQL 8: either one URL (Railway and most hosts give you this) ...
DATABASE_URL=mysql://user:password@host:3306/chesswars
# ... or the separate parts:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=chesswars
# DB_PASSWORD=change-me
# DB_NAME=chesswars

# This server's public address (used in invite links: https://<this>/i/CODE)
PUBLIC_URL=https://api.example.com
# The game page (invite links land here)
GAME_URL=https://mr-chigozie.github.io/battlechess/battle3d.html
# Sites allowed to call the API (comma-separated)
CLIENT_ORIGINS=https://mr-chigozie.github.io

# Closed beta: if set, registering a full account needs this code (guests arriving by invite link are always allowed)
REGISTRATION_CODE=

# Secret for the launch dashboard: GET /api/admin/stats with header  x-admin-key: <ADMIN_KEY>
ADMIN_KEY=change-me-to-a-long-random-string

# Password-reset emails via resend.com (without a key, emails are only printed to the server log)
RESEND_API_KEY=
MAIL_FROM=Chess Wars <no-reply@your-domain.com>
